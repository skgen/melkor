{
  "name": "@skgn/melkor-nuxt",
  "type": "module",
  "version": "1.2.0",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build-runtime": "tsx scripts/build-runtime.ts",
    "prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "prepack": "pnpm build-runtime && nuxt-module-build build",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "review": "pnpm review:typescript && pnpm review:eslint",
    "review:typescript": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "review:eslint": "eslint . --fix"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@skgn/kit": "catalog:",
    "@skgn/melkor": "workspace:^",
    "deepmerge": "catalog:"
  },
  "devDependencies": {
    "@nuxt/devtools": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@types/node": "catalog:",
    "@types/shelljs": "catalog:",
    "@types/yargs": "catalog:",
    "esbuild": "catalog:",
    "nuxt": "catalog:",
    "shelljs": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "yargs": "catalog:"
  }
}
