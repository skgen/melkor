{
  "name": "@skgn/melkor",
  "type": "module",
  "version": "1.8.0",
  "packageManager": "pnpm@9.15.4",
  "description": "Melkor UI",
  "exports": {
    "./nuxt": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/nuxt/build-ssr-theme && nuxt-module-build build",
    "prebuild": "nuxt-module-build prepare",
    "test": "echo \"No test yet\"",
    "review": "pnpm review:typescript && pnpm review:eslint && pnpm review:stylelint",
    "review:typescript": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "review:eslint": "eslint . --fix",
    "review:stylelint": "stylelint 'src/**/*.{css,scss,vue}' --color --fix",
    "changelog": "changelogen --release --no-commit --no-tag",
    "release": "pnpm run review && pnpm run test && pnpm run build && pnpm run changelog"
  },
  "peerDependencies": {
    "vue": "catalog:runtime",
    "vue-router": "catalog:runtime"
  },
  "dependencies": {
    "@iconify/vue": "catalog:runtime",
    "@nuxt/kit": "catalog:build",
    "@skgn/kit": "catalog:runtime",
    "@vueuse/core": "catalog:runtime",
    "deepmerge": "catalog:runtime",
    "defu": "catalog:runtime",
    "lodash-es": "catalog:runtime",
    "normalize.css": "catalog:runtime",
    "reka-ui": "catalog:runtime",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@nuxt/devtools": "catalog:runtime",
    "@nuxt/module-builder": "catalog:build",
    "@nuxt/schema": "catalog:build",
    "@tsconfig/node20": "catalog:build",
    "@types/fs-extra": "catalog:types",
    "@types/jsdom": "catalog:types",
    "@types/lodash-es": "catalog:types",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue/tsconfig": "catalog:build",
    "changelogen": "catalog:",
    "colorette": "catalog:",
    "concurrently": "catalog:",
    "esbuild": "catalog:build",
    "eslint": "catalog:lint",
    "fs-extra": "catalog:build",
    "glob": "catalog:",
    "magic-string": "catalog:build",
    "nitropack": "catalog:build",
    "pathe": "catalog:build",
    "sass": "catalog:",
    "sass-embedded": "catalog:",
    "stylelint": "catalog:lint",
    "stylelint-config-recess-order": "catalog:lint",
    "stylelint-config-standard": "catalog:lint",
    "stylelint-config-standard-scss": "catalog:lint",
    "stylelint-config-standard-vue": "catalog:lint",
    "tsx": "catalog:build",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-no-bundle": "catalog:",
    "vite-plugin-static-copy": "catalog:",
    "vue-component-meta": "catalog:",
    "vue-tsc": "catalog:"
  }
}
