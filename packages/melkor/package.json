{
  "name": "@skgn/melkor",
  "type": "module",
  "version": "2.0.0-alpha.9",
  "description": "Melkor UI",
  "repository": {
    "type": "git",
    "url": "https://github.com/skgen/melkor.git",
    "directory": "packages/melkor"
  },
  "exports": {
    "./nuxt": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.mts",
      "import": "./dist/unplugin.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./vue-plugin": {
      "types": "./dist/runtime/vue/plugin.d.ts",
      "import": "./dist/runtime/vue/plugin.js"
    },
    "./meta": {
      "types": "./dist/meta.d.ts",
      "import": "./dist/meta.json"
    },
    "./styles/css": "./dist/runtime/vue/styles/index.css",
    "./styles/scss": "./dist/runtime/vue/styles/index.scss",
    "./styles/mixins": "./dist/runtime/vue/styles/mixins.scss",
    "./components": {
      "types": "./dist/runtime/vue/components/index.d.ts",
      "import": "./dist/runtime/vue/components/index.js"
    },
    "./composables": {
      "types": "./dist/runtime/vue/composables/index.d.ts",
      "import": "./dist/runtime/vue/composables/index.js"
    },
    "./features": {
      "types": "./dist/runtime/vue/features/index.d.ts",
      "import": "./dist/runtime/vue/features/index.js"
    },
    "./nuxt/components": {
      "types": "./dist/runtime/nuxt/components/index.d.ts",
      "import": "./dist/runtime/nuxt/components/index.js"
    },
    "./nuxt/composables": {
      "types": "./dist/runtime/nuxt/composables/index.d.ts",
      "import": "./dist/runtime/nuxt/composables/index.js"
    },
    "./nuxt/features": {
      "types": "./dist/runtime/nuxt/features/index.d.ts",
      "import": "./dist/runtime/nuxt/features/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "pnpm build",
    "generate": "tsx scripts/generate",
    "prebuild": "nuxt-module-build prepare && tsx scripts/prebuild",
    "build": "nuxt-module-build build",
    "postbuild": "tsx scripts/postbuild",
    "test": "echo \"No test yet\"",
    "review": "pnpm review:typecheck && pnpm review:eslint && pnpm review:stylelint",
    "review:typecheck": "pnpm review:typecheck:vue && pnpm review:typecheck:nuxt",
    "review:typecheck:vue": "vue-tsc --noEmit -p .melkor/tsconfig.vue.json",
    "review:typecheck:nuxt": "vue-tsc --noEmit -p .melkor/tsconfig.nuxt.json",
    "review:eslint": "eslint . --fix",
    "review:stylelint": "stylelint 'src/**/*.{css,scss,vue}' --color --fix",
    "changelog": "changelogen --release --no-commit --no-tag",
    "prepublishOnly": "pnpm run review && pnpm run test"
  },
  "peerDependencies": {
    "vue": "catalog:runtime",
    "vue-router": "catalog:runtime"
  },
  "dependencies": {
    "@iconify/vue": "catalog:runtime",
    "@nuxt/kit": "catalog:build",
    "@skgn/kit": "catalog:runtime",
    "@skgn/melkor-kit": "workspace:*",
    "@skgn/melkor-meta": "workspace:*",
    "@vueuse/core": "catalog:runtime",
    "defu": "catalog:runtime",
    "fs-extra": "catalog:build",
    "glob": "catalog:build",
    "lodash-es": "catalog:runtime",
    "normalize.css": "catalog:runtime",
    "reka-ui": "catalog:runtime",
    "unplugin": "catalog:build",
    "unplugin-auto-import": "catalog:build",
    "unplugin-vue-components": "catalog:build",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:build",
    "@nuxt/schema": "catalog:build",
    "@tsconfig/node22": "catalog:build",
    "@types/fs-extra": "catalog:types",
    "@types/jsdom": "catalog:types",
    "@types/lodash-es": "catalog:types",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue/tsconfig": "catalog:build",
    "changelogen": "catalog:",
    "colorette": "catalog:build",
    "concurrently": "catalog:",
    "esbuild": "catalog:build",
    "eslint": "catalog:lint",
    "magic-string": "catalog:build",
    "nuxt": "catalog:build",
    "pathe": "catalog:build",
    "sass": "catalog:build",
    "stylelint": "catalog:lint",
    "stylelint-config-recess-order": "catalog:lint",
    "stylelint-config-standard": "catalog:lint",
    "stylelint-config-standard-scss": "catalog:lint",
    "stylelint-config-standard-vue": "catalog:lint",
    "tsx": "catalog:build",
    "typescript": "catalog:build",
    "unbuild": "catalog:build",
    "vite": "catalog:build",
    "vue-component-meta": "catalog:build",
    "vue-tsc": "catalog:build"
  }
}
