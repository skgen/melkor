{
  "name": "@skgn/melkor",
  "type": "module",
  "version": "1.8.0",
  "description": "Melkor UI",
  "exports": {
    "./nuxt": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.mts",
      "import": "./dist/unplugin.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./vue-plugin": {
      "types": "./dist/runtime/vue/plugin.d.ts",
      "import": "./dist/runtime/vue/plugin.js"
    },
    "./styles/css": "./dist/runtime/vue/styles/index.css",
    "./styles/scss": "./dist/runtime/vue/styles/index.scss",
    "./styles/mixins": "./dist/runtime/vue/styles/mixins.scss"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "nuxt-module-build prepare && tsx scripts/prebuild",
    "build": "nuxt-module-build build",
    "test": "echo \"No test yet\"",
    "review": "pnpm review:typescript && pnpm review:eslint && pnpm review:stylelint",
    "review:typescript": "pnpm review:typescript:vue && pnpm review:typescript:nuxt",
    "review:typescript:vue": "vue-tsc --noEmit -p .melkor/tsconfig.vue.json",
    "review:typescript:nuxt": "vue-tsc --noEmit -p .melkor/tsconfig.nuxt.json",
    "review:eslint": "eslint . --fix",
    "review:stylelint": "stylelint 'src/**/*.{css,scss,vue}' --color --fix",
    "changelog": "changelogen --release --no-commit --no-tag",
    "release": "pnpm run review && pnpm run test && pnpm run build && pnpm run changelog"
  },
  "peerDependencies": {
    "vue": "catalog:runtime",
    "vue-router": "catalog:runtime"
  },
  "dependencies": {
    "@iconify/vue": "catalog:runtime",
    "@nuxt/kit": "catalog:build",
    "@skgn/kit": "catalog:runtime",
    "@skgn/melkor-kit": "workspace:*",
    "@vueuse/core": "catalog:runtime",
    "defu": "catalog:runtime",
    "fs-extra": "catalog:build",
    "glob": "catalog:build",
    "lodash-es": "catalog:runtime",
    "normalize.css": "catalog:runtime",
    "reka-ui": "catalog:runtime",
    "unplugin": "catalog:build",
    "unplugin-auto-import": "catalog:build",
    "unplugin-vue-components": "catalog:build",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:build",
    "@nuxt/schema": "catalog:build",
    "@skgn/melkor-meta": "workspace:*",
    "@tsconfig/node22": "catalog:build",
    "@types/big-json": "catalog:types",
    "@types/fs-extra": "catalog:types",
    "@types/jsdom": "catalog:types",
    "@types/lodash-es": "catalog:types",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue/tsconfig": "catalog:build",
    "big-json": "catalog:build",
    "changelogen": "catalog:",
    "colorette": "catalog:",
    "concurrently": "catalog:",
    "esbuild": "catalog:build",
    "eslint": "catalog:lint",
    "magic-string": "catalog:build",
    "nuxt": "catalog:build",
    "pathe": "catalog:build",
    "sass": "catalog:build",
    "stylelint": "catalog:lint",
    "stylelint-config-recess-order": "catalog:lint",
    "stylelint-config-standard": "catalog:lint",
    "stylelint-config-standard-scss": "catalog:lint",
    "stylelint-config-standard-vue": "catalog:lint",
    "tsx": "catalog:build",
    "typescript": "catalog:build",
    "unbuild": "catalog:build",
    "vite": "catalog:build",
    "vue-component-meta": "catalog:build",
    "vue-tsc": "catalog:"
  }
}
