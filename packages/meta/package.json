{
  "name": "@skgn/melkor-meta",
  "type": "module",
  "version": "1.0.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "pnpm build",
    "dev": "tsx src/index.ts",
    "build": "unbuild",
    "review": "pnpm review:typecheck && pnpm review:eslint",
    "review:typecheck": "tsc --noEmit -p tsconfig.json",
    "review:eslint": "eslint . --fix",
    "prepublishOnly": "pnpm run review"
  },
  "dependencies": {
    "@skgn/kit": "catalog:runtime",
    "@skgn/melkor-kit": "workspace:*",
    "defu": "catalog:runtime",
    "fs-extra": "catalog:build",
    "glob": "catalog:build",
    "lodash-es": "catalog:runtime",
    "pathe": "catalog:build",
    "tsconfck": "^3.1.6",
    "unbuild": "catalog:build",
    "vue-component-meta": "catalog:build"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:build",
    "@types/fs-extra": "catalog:types",
    "@types/lodash-es": "catalog:types",
    "@types/node": "catalog:types",
    "tsx": "catalog:build",
    "typescript": "catalog:build"
  }
}
